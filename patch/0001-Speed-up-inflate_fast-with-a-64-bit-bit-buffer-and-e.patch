From ec19b74513da5108566ec2ebb26806d02f521a48 Mon Sep 17 00:00:00 2001
From: icodywu <125686483+icodywu@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:28:03 -0700
Subject: [PATCH] Speed up inflate_fast() with a 64-bit bit buffer and
 eight-byte copies.

Where a 64-bit type is available (Z_U8), inflate_fast() first runs a loop that
refills a 64-bit bit buffer eight bytes at a time, once per length/distance
pair or per up to three literals, and copies matches eight bytes at a time
(byte by byte for distances 1 to 7). It runs while sixteen bytes of input
remain and a match plus seven bytes fits in the output; the existing loop
then continues as before, so the entry conditions of inflate_fast() and
everything outside inffast.c stay the same, except the root table sizes: 10
bits for literal/length codes and 8 for distance codes (were 9 and 6), so that
fewer codes need a second lookup. ENOUGH is from examples/enough.c (1332 and
400), and the inflate state grows by 1152 bytes.

inflate() is 48% to 62% faster with the whole stream in one call and 43% to
54% faster with 16K input and 64K output buffers, on Silesia, Canterbury plus
Calgary, and enwik8 at levels 1, 6 and 9 (AMD EPYC 9334, one core, GCC 14.2
-O2 and -O3; clang and GCC 11 alike). 32-bit x86 is 7% faster in one call.

test/infcover.c gains cases for the new loop and for second-level codes with
the larger roots: inffast.c, infback.c and inftrees.c stay at 100% line
coverage.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 infback.c       |   4 +-
 inffast.c       | 235 ++++++++++++++++++++++++++++++++++++++++++++++++
 inflate.c       |   4 +-
 inftrees.h      |  16 ++--
 test/infcover.c |  49 ++++++++++
 5 files changed, 296 insertions(+), 12 deletions(-)

diff --git a/infback.c b/infback.c
index ac96ba1..f80530a 100644
--- a/infback.c
+++ b/infback.c
@@ -398,7 +398,7 @@ int ZEXPORT inflateBack(z_streamp strm, in_func in, void FAR *in_desc,
                concerning the ENOUGH constants, which depend on those values */
             state->next = state->codes;
             state->lencode = (code const FAR *)(state->next);
-            state->lenbits = 9;
+            state->lenbits = 10;
             ret = inflate_table(LENS, state->lens, state->nlen, &(state->next),
                                 &(state->lenbits), state->work);
             if (ret) {
@@ -407,7 +407,7 @@ int ZEXPORT inflateBack(z_streamp strm, in_func in, void FAR *in_desc,
                 break;
             }
             state->distcode = (code const FAR *)(state->next);
-            state->distbits = 6;
+            state->distbits = 8;
             ret = inflate_table(DISTS, state->lens + state->nlen, state->ndist,
                             &(state->next), &(state->distbits), state->work);
             if (ret) {
diff --git a/inffast.c b/inffast.c
index d1657f3..0840569 100644
--- a/inffast.c
+++ b/inffast.c
@@ -12,6 +12,67 @@
 #  pragma message("Assembler code may have bugs -- use at your own risk")
 #else
 
+#ifdef Z_U8
+/* Fast loop: with a 64-bit type the bit buffer is refilled eight bytes at a
+   time, once per code, and matches are copied eight bytes at a time. */
+
+#define TRACE_LITERAL(here) \
+    Tracevv((stderr, (here)->val >= 0x20 && (here)->val < 0x7f ? \
+            "inflate:         literal '%c'\n" : \
+            "inflate:         literal 0x%02x\n", (here)->val))
+
+/* The eight bytes at p, little-endian: one load on a little-endian machine,
+   the bytes one by one otherwise. */
+local Z_U8 load64(z_const unsigned char FAR *p) {
+    Z_U8 v = 1;
+
+    if (*(unsigned char *)&v) {
+        zmemcpy(&v, p, 8);
+        return v;
+    }
+    return (Z_U8)p[0] | ((Z_U8)p[1] << 8) | ((Z_U8)p[2] << 16) |
+           ((Z_U8)p[3] << 24) | ((Z_U8)p[4] << 32) | ((Z_U8)p[5] << 40) |
+           ((Z_U8)p[6] << 48) | ((Z_U8)p[7] << 56);
+}
+
+/* Copy len >= 1 bytes from dist bytes back in the output to out, and return
+   out + len. It may write up to seven bytes after out + len, so the caller
+   must have that room. */
+local unsigned char FAR *copy_back(unsigned char FAR *out, unsigned dist,
+                                   unsigned len) {
+    unsigned char FAR *from = out - dist;
+    unsigned char FAR *stop = out + len;
+
+    if (dist >= 8) {                    /* eight at a time, no overlap */
+        do {
+            zmemcpy(out, from, 8);
+            out += 8;
+            from += 8;
+        } while (out < stop);
+        return stop;
+    }
+    if (dist == 1) {                    /* a run of one byte */
+        unsigned char c = *from;
+        do {
+            *out++ = c;
+        } while (--len);
+        return stop;
+    }
+    while (len > 2) {                   /* after a window copy, len may be 1 */
+        *out++ = *from++;
+        *out++ = *from++;
+        *out++ = *from++;
+        len -= 3;
+    }
+    if (len) {
+        *out++ = *from++;
+        if (len > 1)
+            *out++ = *from++;
+    }
+    return stop;
+}
+#endif
+
 /*
    Decode literal, length, and distance codes and write out the resulting
    literal and match bytes until either not enough input or output is
@@ -73,6 +134,11 @@ void ZLIB_INTERNAL inflate_fast(z_streamp strm, unsigned start) {
     unsigned len;               /* match length, unused bytes */
     unsigned dist;              /* match distance */
     unsigned char FAR *from;    /* where to copy match from */
+#ifdef Z_U8
+    Z_U8 hold8;                 /* 64-bit bit buffer of the fast loop */
+    z_const unsigned char FAR *last8;   /* two refills fit after in */
+    unsigned char FAR *end8;    /* room for a match and seven more bytes */
+#endif
 
     /* copy state to local variables */
     state = (struct inflate_state FAR *)strm->state;
@@ -95,6 +161,172 @@ void ZLIB_INTERNAL inflate_fast(z_streamp strm, unsigned start) {
     lmask = (1U << state->lenbits) - 1;
     dmask = (1U << state->distbits) - 1;
 
+#ifdef Z_U8
+    /* Fast loop, while sixteen bytes can be read at in (two refills of
+       eight bytes, the first advancing in by up to seven) and a match plus
+       seven bytes fits in the output. Each length/literal code starts with
+       at least 56 bits in hold8, enough for a length/distance pair (at most
+       48 bits). */
+    if (strm->avail_in >= 16 && strm->avail_out >= 258 + 7) {
+        last8 = in + (strm->avail_in - 16);
+        end8 = out + (strm->avail_out - (258 + 7));
+        hold8 = hold;
+        do {
+            hold8 |= load64(in) << bits;
+            in += (63 - bits) >> 3;
+            bits |= 56;
+            here = lcode + (hold8 & lmask);
+            if (here->op == 0) {        /* up to three literals a refill */
+                hold8 >>= here->bits;
+                bits -= here->bits;
+                TRACE_LITERAL(here);
+                *out++ = (unsigned char)(here->val);
+                here = lcode + (hold8 & lmask);
+                if (here->op == 0) {
+                    hold8 >>= here->bits;
+                    bits -= here->bits;
+                    TRACE_LITERAL(here);
+                    *out++ = (unsigned char)(here->val);
+                    here = lcode + (hold8 & lmask);
+                    if (here->op == 0) {
+                        hold8 >>= here->bits;
+                        bits -= here->bits;
+                        TRACE_LITERAL(here);
+                        *out++ = (unsigned char)(here->val);
+                        continue;
+                    }
+                }
+                hold8 |= load64(in) << bits;    /* 56 bits for a pair */
+                in += (63 - bits) >> 3;
+                bits |= 56;
+            }
+          dolen8:
+            op = (unsigned)(here->bits);
+            hold8 >>= op;
+            bits -= op;
+            op = (unsigned)(here->op);
+            if (op == 0) {                      /* literal */
+                TRACE_LITERAL(here);
+                *out++ = (unsigned char)(here->val);
+            }
+            else if (op & 16) {                 /* length base */
+                len = (unsigned)(here->val);
+                op &= 15;                       /* number of extra bits */
+                len += (unsigned)hold8 & ((1U << op) - 1);
+                hold8 >>= op;
+                bits -= op;
+                Tracevv((stderr, "inflate:         length %u\n", len));
+                here = dcode + (hold8 & dmask);
+              dodist8:
+                op = (unsigned)(here->bits);
+                hold8 >>= op;
+                bits -= op;
+                op = (unsigned)(here->op);
+                if (op & 16) {                  /* distance base */
+                    dist = (unsigned)(here->val);
+                    op &= 15;                   /* number of extra bits */
+                    dist += (unsigned)hold8 & ((1U << op) - 1);
+#ifdef INFLATE_STRICT
+                    if (dist > dmax) {
+                        strm->msg = (z_const char *)
+                            "invalid distance too far back";
+                        state->mode = BAD;
+                        break;
+                    }
+#endif
+                    hold8 >>= op;
+                    bits -= op;
+                    Tracevv((stderr, "inflate:         distance %u\n", dist));
+                    op = (unsigned)(out - beg); /* max distance in output */
+                    if (dist > op) {            /* see if copy from window */
+                        op = dist - op;         /* distance back in window */
+                        if (op > whave) {
+                            if (state->sane) {
+                                strm->msg = (z_const char *)
+                                    "invalid distance too far back";
+                                state->mode = BAD;
+                                break;
+                            }
+#ifdef INFLATE_ALLOW_INVALID_DISTANCE_TOOFAR_ARRR
+                            if (len <= op - whave) {
+                                do {
+                                    *out++ = 0;
+                                } while (--len);
+                                continue;
+                            }
+                            len -= op - whave;
+                            do {
+                                *out++ = 0;
+                            } while (--op > whave);
+                            if (op == 0) {
+                                out = copy_back(out, dist, len);
+                                continue;
+                            }
+#endif
+                        }
+                        from = window;
+                        if (wnext == 0)         /* very common case */
+                            from += wsize - op;
+                        else if (wnext < op) {  /* wrap around window */
+                            from += wsize + wnext - op;
+                            op -= wnext;
+                            if (op < len) {     /* end of window, then start */
+                                zmemcpy(out, from, op);
+                                out += op;
+                                len -= op;
+                                from = window;
+                                op = wnext;
+                            }
+                        }
+                        else                    /* contiguous in window */
+                            from += wnext - op;
+                        if (op > len)
+                            op = len;
+                        zmemcpy(out, from, op); /* from the window */
+                        out += op;
+                        len -= op;
+                        if (len)                /* rest from output */
+                            out = copy_back(out, dist, len);
+                    }
+                    else
+                        out = copy_back(out, dist, len);
+                }
+                else if ((op & 64) == 0) {      /* 2nd level distance code */
+                    here = dcode + here->val + (hold8 & ((1U << op) - 1));
+                    goto dodist8;
+                }
+                else {
+                    strm->msg = (z_const char *)"invalid distance code";
+                    state->mode = BAD;
+                    break;
+                }
+            }
+            else if ((op & 64) == 0) {          /* 2nd level length code */
+                here = lcode + here->val + (hold8 & ((1U << op) - 1));
+                goto dolen8;
+            }
+            else if (op & 32) {                 /* end-of-block */
+                Tracevv((stderr, "inflate:         end of block\n"));
+                state->mode = TYPE;
+                break;
+            }
+            else {
+                strm->msg = (z_const char *)"invalid literal/length code";
+                state->mode = BAD;
+                break;
+            }
+        } while (in <= last8 && out < end8);
+
+        /* return the whole bytes not used, leaving fewer than eight bits */
+        len = bits >> 3;
+        in -= len;
+        bits -= len << 3;
+        hold = (unsigned long)(hold8 & ((1U << bits) - 1));
+        if (state->mode != LEN || in >= last || out >= end)
+            goto leave;
+    }
+#endif
+
     /* decode literals and length/distances until end-of-block or not enough
        input data or output space */
     do {
@@ -287,6 +519,9 @@ void ZLIB_INTERNAL inflate_fast(z_streamp strm, unsigned start) {
         }
     } while (in < last && out < end);
 
+#ifdef Z_U8
+  leave:
+#endif
     /* return unused bytes (on entry, bits < 8, so in won't go too far back) */
     len = bits >> 3;
     in -= len;
diff --git a/inflate.c b/inflate.c
index 5f5d492..239f171 100644
--- a/inflate.c
+++ b/inflate.c
@@ -887,7 +887,7 @@ int ZEXPORT inflate(z_streamp strm, int flush) {
                concerning the ENOUGH constants, which depend on those values */
             state->next = state->codes;
             state->lencode = (const code FAR *)(state->next);
-            state->lenbits = 9;
+            state->lenbits = 10;
             ret = inflate_table(LENS, state->lens, state->nlen, &(state->next),
                                 &(state->lenbits), state->work);
             if (ret) {
@@ -896,7 +896,7 @@ int ZEXPORT inflate(z_streamp strm, int flush) {
                 break;
             }
             state->distcode = (const code FAR *)(state->next);
-            state->distbits = 6;
+            state->distbits = 8;
             ret = inflate_table(DISTS, state->lens + state->nlen, state->ndist,
                             &(state->next), &(state->distbits), state->work);
             if (ret) {
diff --git a/inftrees.h b/inftrees.h
index 20eb2c0..d8d0eed 100644
--- a/inftrees.h
+++ b/inftrees.h
@@ -36,23 +36,23 @@ typedef struct {
  */
 
 /* Maximum size of the dynamic table.  The maximum number of code structures is
-   1444, which is the sum of 852 for literal/length codes and 592 for distance
+   1732, which is the sum of 1332 for literal/length codes and 400 for distance
    codes.  These values were found by exhaustive searches using the program
    examples/enough.c found in the zlib distribution.  The arguments to that
    program are the number of symbols, the initial root table size, and the
-   maximum bit length of a code.  "enough 286 9 15" for literal/length codes
-   returns 852, and "enough 30 6 15" for distance codes returns 592. The
-   initial root table size (9 or 6) is found in the fifth argument of the
+   maximum bit length of a code.  "enough 286 10 15" for literal/length codes
+   returns 1332, and "enough 30 8 15" for distance codes returns 400. The
+   initial root table size (10 or 8) is found in the fifth argument of the
    inflate_table() calls in inflate.c and infback.c.  If the root table size is
    changed, then these maximum sizes would be need to be recalculated and
    updated. */
 #ifndef PKZIP_BUG_WORKAROUND
-#  define ENOUGH_LENS 852
-#  define ENOUGH_DISTS 592
+#  define ENOUGH_LENS 1332
+#  define ENOUGH_DISTS 400
 #else
 /* That workaround permits 288 literal/length codes and 32 distance codes. */
-#  define ENOUGH_LENS 854
-#  define ENOUGH_DISTS 594
+#  define ENOUGH_LENS 1334
+#  define ENOUGH_DISTS 402
 #endif
 #define ENOUGH (ENOUGH_LENS+ENOUGH_DISTS)
 
diff --git a/test/infcover.c b/test/infcover.c
index f1ad0f9..dfb8f6d 100644
--- a/test/infcover.c
+++ b/test/infcover.c
@@ -659,6 +659,54 @@ local void cover_fast(void)
         Z_STREAM_END);
 }
 
+/* cover the fast loop of inffast.c, which needs sixteen bytes of input and
+   room for 265 bytes of output: second-level codes with 10- and 8-bit root
+   tables, literal runs, copies at distances 1, 2..7 and 8 or more, window
+   copies (wrapped, contiguous, and with the write index at zero), and its
+   errors */
+local void cover_fast64(void)
+{
+    char *longcodes =
+        "ed ef d1 92 24 49 92 24 cb 7e 2b 5e 16 35 8f ec ff ff 0 2a 80 79 d9 "
+        "87 f3 9 f7 22 1d 96 55 1b 8f ce 5b fe 7f bb f7 fd fe fe fd ef bf ff "
+        "df ff fd 7f ff cf ff f7 ff e1 ff f9 7f fc 7f fc 1f fe ff ff bf ff ff "
+        "ff c0 ff fc ff e0 bf ff 80 0";
+    char *win12 =
+        "4b 4c 4a 4e 49 4d 4b cf c8 cc ca ce c9 cd cb 2f 28 2c 2a 2e 29 2d 2b "
+        "af a8 ac 1a 95 19 d 9b d1 b0 1a d ab d1 b0 1a d ab d1 b0 1a 75 c3 68 "
+        "58 8d 86 d5 68 cc 8f 86 d5 68 58 8d 86 d5 68 58 8d 86 d5 68 58 8d 86 "
+        "db 68 58 8d c6 d5 68 58 8d 96 d3 a3 61 35 1a 56 a3 ad ae d1 b0 1a f5 "
+        "e9 68 58 8d 86 ee 68 58 8d 86 d5 68 df 7d 34 ac 46 d3 e1 68 58 8d ba "
+        "6d 34 ac 46 c3 6a 34 45 8c 86 d5 68 6b 66 34 ac 46 5b e6 a3 61 35 1a "
+        "56 a3 e1 39 1a 56 a3 71 38 1a 56 a3 f1 3b 1a 56 a3 61 35 5a 5a 8f 86 "
+        "d5 68 8 8c 86 55 6a 5e a 0";
+    char *win9 =
+        "4b 4c 4a 4e 49 4d 4b cf c8 cc ca ce c9 cd cb 2f 28 2c 2a 2e 29 2d 2b "
+        "af a8 ac 1a 95 19 5 a3 61 35 1a e7 a3 76 8c a2 d1 f8 1f d 83 51 38 "
+        "1a 1f a3 8a 46 63 70 94 1e d cc d4 bc 14 0";
+
+    inf(longcodes, "fast long codes", 0, -15, 1000, Z_STREAM_END);
+    inf("4a 4c 4a 6 2c 25 35 2d 3d 23 33 2b 3b 27 37 2f bf a0 b0 a8 b8 a4 b4 "
+        "ac bc a2 b2 2a 31 29 39 25 35 2d 3d 23 33 2b 3b 27 37 2f bf 0 0",
+        "fast end of block", 0, -15, 300, Z_STREAM_END);
+    inf(longcodes, "long codes in small pieces", 3, -15, 100, Z_OK);
+    try(longcodes, "long codes", 0);
+    inf(win12, "fast window copies", 0, -12, 600, Z_OK);
+    inf(win9, "fast window write index zero", 0, -9, 600, Z_OK);
+    inf("4b 4c 4a 4e 49 4d 4b cf c8 cc ca ce c9 cd cb 2f 40 d8 91 98 94 9c 92 "
+        "9a 96 9e 91 99 95 9d 93 9b 97 5f 50 58 54 5c 52 5a 56 5e 51 59 95 98 "
+        "94 9c 92 9a 6 0",
+        "fast too far back", 0, -15, 300, Z_DATA_ERROR);
+    inf("4b 4c 4a 4e 49 4d 4b cf c8 cc ca ce c9 cd cb 2f 18 4b 4c 4a 4e 49 4d "
+        "4b cf c8 cc ca ce c9 cd cb 2f 28 2c 2a 2e 29 2d 2b af a8 ac 4a 4c 4a "
+        "4e 49 4d 3 0",
+        "fast invalid literal/length code", 0, -15, 300, Z_DATA_ERROR);
+    inf("4b 4c 4a 4e 49 4d 4b cf c8 cc ca ce c9 cd cb 2f 0 be c4 a4 e4 94 d4 "
+        "b4 f4 8c cc ac ec 9c dc bc fc 82 c2 a2 e2 92 d2 b2 f2 8a ca aa c4 a4 "
+        "e4 94 d4 34 0",
+        "fast invalid distance code", 0, -15, 300, Z_DATA_ERROR);
+}
+
 int main(void)
 {
     fprintf(stderr, "%s\n", zlibVersion());
@@ -668,5 +716,6 @@ int main(void)
     cover_inflate();
     cover_trees();
     cover_fast();
+    cover_fast64();
     return 0;
 }
